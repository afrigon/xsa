flat "base-surfaces:regolith" variant-noise=10 height-contrast=0.4
slope "base-surfaces:regolith-cratered" variant-noise=10 height-contrast=0.4
steep "base-surfaces:regolith-rocky" variant-noise=10 height-contrast=0.4
handovers {
    flat-to-slope angle=10 width=6
    slope-to-steep angle=25 width=8
    noise size=20000 amplitude=3
}
